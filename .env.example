# HTTP port.
PORT=4200
# SQLite file. The fictional plant is seeded automatically when the file is empty.
DATABASE_PATH=./data/cmms.db

# Protect a hosted copy. When set, the dashboard asks for this password.
DEMO_PASSWORD=
# Optional: secret used to sign session cookies (defaults to one derived from DEMO_PASSWORD).
SESSION_SECRET=

# Runs the PM and surveillance generator at startup and every hour.
SCHEDULER_ENABLED=true
